# Server port
PORT=3000

# Full MongoDB connection string. Takes precedence over DB_USER / DB_PASS when set.
# Docker Compose sets this to the bundled mongo service automatically.
MONGODB_URI=

# MongoDB Atlas credentials (used only when MONGODB_URI is not set)
DB_USER=
DB_PASS=

# JWT signing secret
ACCESS_TOKEN_SECRET=

# SSLCommerz sandbox credentials
STORE_ID=
STORE_PASS=
