# Server
PORT=3000
NODE_ENV=development

# Where the frontend runs (CORS origin, allows credentialed requests)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of this API (used for SSLCommerz callback URLs)
API_BASE_URL=http://localhost:3000

# Full MongoDB connection string. Takes precedence over DB_USER / DB_PASS when set.
# Docker Compose sets this to the bundled mongo service automatically.
MONGODB_URI=
DB_NAME=jashoreFoodiesDB

# MongoDB Atlas credentials (used only when MONGODB_URI is not set)
DB_USER=
DB_PASS=

# JWT secrets (use long random strings; keep them different)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# First admin account, created by: pnpm --filter @jashore-foodies/backend seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SSLCommerz sandbox credentials
STORE_ID=
STORE_PASS=
SSL_IS_LIVE=false

# S3-compatible object storage (MinIO in dev). S3_ENDPOINT is used server-side;
# S3_PUBLIC_ENDPOINT is what the browser hits (presigned upload + public read).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=jashore-foodies
S3_FORCE_PATH_STYLE=true
